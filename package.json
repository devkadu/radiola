{
  "name": "radiola",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start -p ${PORT:-3000}",
    "lint": "node scripts/lint.mjs",
    "typecheck": "next typegen && tsc --noEmit --incremental false",
    "test": "vitest run",
    "test:unit": "vitest run",
    "test:e2e": "playwright test",
    "db:migration:new": "supabase migration new",
    "privacy:account": "node scripts/privacy-account.mjs",
    "check:secrets": "git ls-files -z --cached --others --exclude-standard | node scripts/check-secrets.mjs",
    "check:unused": "knip",
    "bots:sync": "node scripts/sync-bot-rules.mjs --write",
    "bots:check": "node scripts/sync-bot-rules.mjs",
    "check": "yarn run check:secrets && yarn run check:unused && yarn run bots:check && yarn run lint && yarn run typecheck && yarn run test:unit",
    "build:check": "node scripts/build-check.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@anthropic-ai/sdk": "1.1.0",
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.118.0",
    "@tanstack/react-query": "5.104.5",
    "@tanstack/react-query-devtools": "5.104.5",
    "next": "16.4.2",
    "postcss": "8.5.31",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-icons": "5.7.0",
    "react-markdown": "^10.1.0",
    "resend": "6.34.1",
    "server-only": "0.0.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@electric-sql/pglite": "0.5.13",
    "@playwright/test": "1.64.1",
    "@tailwindcss/postcss": "4.3.3",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "dotenv": "18.0.9",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.2",
    "jsdom": "30.1.3",
    "knip": "6.42.1",
    "prettier": "3.9.10",
    "supabase": "2.122.0",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  },
  "engines": {
    "node": "24.x"
  },
  "packageManager": "yarn@1.22.22"
}
