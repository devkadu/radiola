# Configure a project dedicated to development before using real accounts.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-with-public-key
# Private values: never prefix with NEXT_PUBLIC_. Prefer the new secret key.
SUPABASE_SECRET_KEY=replace-with-private-key
# Legacy fallback only, until the existing privileged key has been rotated:
# SUPABASE_SERVICE_ROLE_KEY=
ADMIN_USER_ID=
TMDB_ACCESS_TOKEN=
# Optional server-only override; defaults to https://api.themoviedb.org/3.
# TMDB_API_BASE_URL=https://api.themoviedb.org/3
RESEND_API_KEY=
ANTHROPIC_API_KEY=
